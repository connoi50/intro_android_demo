[Unit]
Description=Push-Based Remote Systemd Service Monitoring Agent
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/push-monitoring-agent
ExecStart=/usr/bin/python3 /opt/push-monitoring-agent/push-monitoring-agent.py --service myapp --pushgateway http://YOUR_PUSHGATEWAY_IP:9091 --instance remote-myapp-server --interval 30
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target